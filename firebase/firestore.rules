rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Perfil privado (XP, monedas, récords, accesorios) ─────────────────
    match /usuarios/{uid} { allow read, write: if isMe(uid); }
    match /visitas/{uid}  { allow read, write: if isMe(uid); }

    // ── Perfil público (búsqueda social) y ranking global ─────────────────
    match /users/{uid}   { allow read: if signedIn(); allow write: if isMe(uid); }
    match /ranking/{uid} { allow read: if true;       allow write: if isMe(uid); }

    // ── Ranking por juego: leaderboards/{juegoId__modo}/scores/{uid} ──────
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow write: if isMe(uid)
                   && request.resource.data.uid == uid
                   && request.resource.data.score is number;
    }

    // ── Amigos y solicitudes: lo puede escribir cualquiera de los dos involucrados
    match /friends/{uid}/list/{friendUid} {
      allow read: if isMe(uid);
      allow write: if isMe(uid) || isMe(friendUid);
    }
    match /friendRequests/{uid}/{direction}/{otherUid} {
      allow read: if isMe(uid);
      allow write: if isMe(uid) || isMe(otherUid);
    }

    // ── Chat 1 a 1: chatId = uidA_uidB (ordenados) ────────────────────────
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create, update: if signedIn()
                            && request.auth.uid in chatId.split('_')
                            && request.auth.uid in request.resource.data.participants;
      match /messages/{msgId} {
        allow read, update: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn() && request.auth.uid in chatId.split('_')
                      && request.resource.data.from == request.auth.uid;
      }
    }

    // ── Invitaciones a jugar ──────────────────────────────────────────────
    match /gameInvites/{uid}/pending/{inviteId} {
      allow read, delete: if isMe(uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
    }

    // ── Grupos de amigos ──────────────────────────────────────────────────
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 20;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members.size() <= 20;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /messages/{mid} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        allow create: if signedIn()
                      && request.resource.data.from == request.auth.uid
                      && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(gid)).data.members;
      }
    }
  }
}
