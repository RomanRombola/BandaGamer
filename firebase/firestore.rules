rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Perfil privado (XP, monedas, récords, accesorios) ─────────────────
    match /usuarios/{uid} { allow read, write: if isMe(uid); }
    match /visitas/{uid}  { allow read, write: if isMe(uid); }

    // ── Perfil público (búsqueda social) y ranking global ─────────────────
    // Límites de tamaño: estos documentos los descargan todos los que abren el ranking o
    // buscan amigos. Una "foto" de 1 MB en un perfil hacía pesado el ranking para todos.
    // (Las fotos que sube la página son de 200×200 y pesan ~15 KB.)
    function perfilPublicoValido() {
      let d = request.resource.data;
      return (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 60))
          && (!('fotoPerfil' in d) || d.fotoPerfil == null || (d.fotoPerfil is string && d.fotoPerfil.size() <= 120000))
          && (!('xp' in d) || d.xp is number);
    }
    match /users/{uid}   { allow read: if signedIn(); allow delete: if isMe(uid); allow create, update: if isMe(uid) && perfilPublicoValido(); }
    match /ranking/{uid} { allow read: if true;       allow delete: if isMe(uid); allow create, update: if isMe(uid) && perfilPublicoValido(); }

    // ── Ranking por juego: leaderboards/{juegoId__modo}/scores/{uid} ──────
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow write: if isMe(uid)
                   && request.resource.data.uid == uid
                   && request.resource.data.score is number
                   && request.resource.data.score > 0
                   && request.resource.data.nombre is string
                   && request.resource.data.nombre.size() <= 24;
    }

    // ── Amigos y solicitudes: lo puede escribir cualquiera de los dos involucrados
    // Antes cualquiera podía escribirse solo en la lista de amigos de otro (amistad forzada,
    // sin que el otro acepte). Ahora, para escribir en la lista AJENA tiene que existir la
    // solicitud de amistad que esa persona me mandó (se valida contra el estado previo al
    // batch de Social.aceptarSolicitud). Borrar (eliminar amigo) lo puede hacer cualquiera de los dos.
    match /friends/{uid}/list/{friendUid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid)
                            || (isMe(friendUid)
                                && exists(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(uid)));
      allow delete: if isMe(uid) || isMe(friendUid);
    }
    match /friendRequests/{uid}/{direction}/{otherUid} {
      allow read: if isMe(uid);
      allow write: if isMe(uid) || isMe(otherUid);
    }

    // ── Chat 1 a 1: chatId = uidA_uidB (ordenados) ────────────────────────
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create, update: if signedIn()
                            && request.auth.uid in chatId.split('_')
                            && request.auth.uid in request.resource.data.participants;
      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        // Solo se puede marcar como leído: antes cualquiera de los dos podía reescribir
        // el texto de los mensajes del otro.
        allow update: if signedIn() && request.auth.uid in chatId.split('_')
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
        allow create: if signedIn() && request.auth.uid in chatId.split('_')
                      && request.resource.data.from == request.auth.uid;
      }
    }

    // ── Invitaciones a jugar ──────────────────────────────────────────────
    match /gameInvites/{uid}/pending/{inviteId} {
      allow read, delete: if isMe(uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
    }

    // ── Grupos de amigos ──────────────────────────────────────────────────
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 20;
      // Un miembro no puede adueñarse del grupo cambiando "owner"
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.members.size() <= 20;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /messages/{mid} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        allow create: if signedIn()
                      && request.resource.data.from == request.auth.uid
                      && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(gid)).data.members;
      }
    }
  }
}
